# Questo è un file env di esempio da utilizzare nel progetto.
# PRODUCTION environment variable 
# is true if we are in production, 
# false if we are in a test environment
PRODUCTION=false
# Number PORT
PORT=3000
# JWT SECRET
JWT_SECRET=xxxxxxxxxxxxxxxxxx
# BASE PATH
BASE_PATH=http://localhost:3000
# SESSION SECRET
SESSION_SECRET=xxxxxxxxxxxxxxxxxx