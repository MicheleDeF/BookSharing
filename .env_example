# Questo è un file .env di esempio da utilizzare nel progetto.

# Variabile d'ambiente PRODUCTION
# è true se ci troviamo in produzione,
# false se ci troviamo in un ambiente di test
PRODUCTION=false

# Numbero PORTA
PORT=3000

# JWT SECRET é una stringa alfanumerica per genrare il jwt web token
JWT_SECRET=xxxxxxxxxxxxxxxxxx

# BASE PATH è il dominio dell'applicazione
BASE_PATH=http://localhost:3000

# SESSION SECRET è una stringa alfanumerica per crittografare le sessioni utente
SESSION_SECRET=xxxxxxxxxxxxxxxxxx

# La variabile "NODE_ENV" è impostata su "development" per impostazione predefinita durante la fase di sviluppo;
# quando l'applicazione viene distribuita sul server per la fase di produzione
# occorre impostare "NODE_ENV" su "production", utilizzando i dati del database di produzione.
NODE_ENV =development