# This is a sample .env file to use in the project.

# PRODUCTION environment variable 
# is true if we are in production, 
# false if we are in a test environment
PRODUCTION=false

# Number PORT
PORT=3000

# JWT SECRET
JWT_SECRET=xxxxxxxxxxxxxxxxxx

# BASE PATH
BASE_PATH=http://localhost:3000

# SESSION SECRET
SESSION_SECRET=xxxxxxxxxxxxxxxxxx

# The "NODE_ENV" variable is set to "development" by default for the development phase; 
# when the application is deployed to the server for the production phase, 
# set "NODE_ENV" to "production" using the production database data.
NODE_ENV =development