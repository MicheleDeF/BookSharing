<div class="col-md-7 col-lg-8">    
    <div class="card shadow-sm p-4 mb-4 bg-white rounded">
        <div class="d-flex flex-wrap gap-2 mb-3">
            <span class="badge bg-secondary px-3 py-2 rounded-pill fs-6">{{detailBook.category}}</span>
        </div>
        <h1 class="display-5 fw-bold text-dark mb-1">{{detailBook.title}}</h1>
        <p class="fs-4 text-muted mb-3">di <span class="text-dark fw-semibold">{{detailBook.author}}</span>, anno di pubblicazione <span class="text-dark fw-semibold">{{detailBook.publish_year}}</span></p>
        <hr class="my-4">
        <div class="row g-3 mb-4">
            <div class="col-sm-5">
                <div class="d-flex align-items-center">
                    <i class="fa-solid fa-calendar text-primary fs-4 me-3"></i>
                    <div>
                        <small class="text-muted d-block">Data di Inserimento</small>
                        <span class="fw-medium">{{customizeData detailBook.createdAt}}</span>
                    </div>
                </div>
            </div>
            <div class="col-sm-7">
                <div class="d-flex align-items-center">
                    <i class="fa-solid fa-door-open text-primary fs-4 me-3"></i>
                    <div>
                        <small class="text-muted d-block">Indirizzo di Scambio</small>
                        <span class="fw-medium">{{detailBook.address}}</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="alert alert-primary d-flex align-items-center mb-4" role="alert">
            <i class="fa-solid fa-street-view fs-4 me-3"></i>
            <div>
                Questo libro viene condiviso entro un raggio di <strong>{{detailBook.radius}} metri</strong> dal proprietario del libro.
            </div>
        </div>
        <h5 class="fw-bold mb-3">Descrizione libro</h5>
        <p class="text-secondary leading-relaxed">
            {{detailBook.description}}
        </p>
        <p>
            <ul class="list-inline">
                <li class="list-inline-item">
                    <a href="#" class="link-primary" data-bs-toggle="tooltip" data-bs-title="Condividi su Facebook">
                        <span class="fa-stack" style="vertical-align: top;">
                            <i class="fa-solid fa-circle fa-stack-2x"></i>
                            <i class="fa-brands fa-facebook-f fa-stack-1x fa-inverse"></i>
                        </span>
                    </a>
                </li>
                <li class="list-inline-item">
                    <a href="#" class="link-dark" data-bs-toggle="tooltip" data-bs-title="Condividi su X/Twitter">
                        <span class="fa-stack" style="vertical-align: top;">
                            <i class="fa-solid fa-circle fa-stack-2x"></i>
                            <i class="fa-brands fa-x-twitter fa-stack-1x fa-inverse"></i>
                        </span>
                    </a>
                </li>
                <li class="list-inline-item">
                    <a href="#" class="link-danger" data-bs-toggle="tooltip" data-bs-title="Condividi su Pinterest">
                        <span class="fa-stack" style="vertical-align: top;">
                            <i class="fa-solid fa-circle fa-stack-2x"></i>
                            <i class="fa-brands fa-pinterest-p fa-stack-1x fa-inverse"></i>
                        </span>
                    </a>
                </li>
                <li class="list-inline-item">
                    <a href="#" class="link-info" data-bs-toggle="tooltip" data-bs-title="Condividi su Instagram">
                        <span class="fa-stack" style="vertical-align: top;">
                            <i class="fa-solid fa-circle fa-stack-2x"></i>
                            <i class="fa-brands fa-instagram fa-stack-1x fa-inverse"></i>
                        </span>
                    </a>
                </li>
            </ul>
        </p>
    </div>
    <div class="card shadow-sm p-4 bg-white rounded">
        <h5 class="card-title border-bottom pb-3 mb-3">Info proprietario</h5>
        <div class="d-flex align-items-start align-items-sm-center flex-column flex-sm-row">
            <img src="{{detailBook.user.avatar}}" class="rounded-circle mb-3 mb-sm-0 me-sm-4 shadow-sm">                    
            <div>
                <h4 class="h5 fw-bold mb-1">{{detailBook.user.firstName}} {{detailBook.user.lastName}}</h4>
                <p class="text-secondary mb-0">
                        {{detailBook.user.description}} 
                </p>
            </div>
        </div>
        {{#if (eq lenghtUserBooks 0)}}
                <!-- Nessun libro in evidenza da mostrare -->
            {{else}}
        <hr/>
        <h6 class="card-title border-bottom pb-3 mb-3">
            <i>...ecco tutta la collezione di libri (<strong class="text-success">{{lenghtUserBooks}}</strong>) di <strong>{{detailBook.user.firstName}} {{detailBook.user.lastName}}</strong>:</i>
        </h6>                
        <div class="container my-5">
         <div class="swiper other_books position-relative">
            <div class="swiper-wrapper">
                {{#each userBooks}}                    
                    <div class="swiper-slide">
                        <div class="card shadow-sm border">
                            <img src="{{this.cover}}" class="card-img-top" alt="{{this.title}}">
                            <div class="card-body d-flex flex-column text-center">
                                <h6 class="card-title fw-bold">
                                    <a href="/book/{{this.id}}/{{this.slug}}">{{truncate this.title 20}}</a>   
                                </h6>
                                <p class="card-text text-muted flex-grow-1">{{this.category}}</p>                                
                            </div>
                        </div>
                    </div>                    
                {{/each}}
            </div>
            <div class="swiper-button-next"></div>
            <div class="swiper-button-prev"></div>
         </div>
        </div>
        {{/if}}
        <p class="border">
            {{#if userLogged.logged}} 

                {{#if (eq userLogged.id detailBook.user.id)}} 
                    <!--
                    Nota:
                    l'utente loggato è il proprietario del libro,
                    il form "Contatta il proprietario" non è visibile.                            
                    -->
                {{else}} 
                {{#if (eq detailBook.availability 0)}}
                <!-- visualizza alert per libro non disponibile per lo scambio -->
                <div class="alert alert-success" role="alert">
                    <h4 class="alert-heading">
                        <i class="fa-solid fa-circle-info"></i> 
                        Questo libro non è al momento disponibile per lo scambio!
                    </h4>
                    <hr>
                    <p class="mb-0">
                        Puoi comunque contattare il proprietario per richiedere informazioni.
                    </p>
                </div>
                {{else}}
                <!-- non visualizza nessun alert, libro disponibile per lo scambio -->
                {{/if}}
                <!-- Form per contattare il proprietario del libro -->
                <form id="sendMesssageOnDetailBook">
                    <input type="hidden" name="recipient" value="{{detailBook.user.id}}">
                    <input type="hidden" name="bookId" value="{{detailBook.id}}">
                    <div class="mb-3">
                        <textarea name="textRecipient" class="form-control border border-primary" placeholder="....contatta {{detailBook.user.firstName}} {{detailBook.user.lastName}}" rows="4" required></textarea>
                    </div>
                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <button type="submit" class="btn btn-primary me-md-2">
                            <i class="fa-solid fa-message me-2"></i> Invia Messaggio
                        </button>
                    </div>
                </form>
                {{/if}} 

            {{else}}  
            {{#if (eq detailBook.availability 0)}}
            <!-- visualizza alert per libro non disponibile per lo scambio -->
            <div class="alert alert-success" role="alert">
                <h4 class="alert-heading">
                    <i class="fa-solid fa-circle-info"></i> 
                    Questo libro non è al momento disponibile per lo scambio!
                </h4>
                <hr>
                <p class="mb-0">
                    Puoi comunque contattare il proprietario per richiedere informazioni.
                </p>
            </div>
            {{else}}
                <!-- non visualizza nessun alert, libro disponibile per lo scambio -->
            {{/if}}
            <!-- Form per contattare il proprietario del libro -->
            <form onsubmit="notLogged(); return false;">
                <div class="mb-3">
                    <textarea name="textRecipient" class="form-control border border-primary" placeholder="....contatta {{detailBook.user.firstName}} {{detailBook.user.lastName}}" rows="4"></textarea>
                </div>
                <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                    <button type="submit" class="btn btn-primary me-md-2">
                        <i class="fa-solid fa-message me-2"></i> Invia Messaggio
                    </button>
                </div>
            </form>
            {{/if}}                       
        </p>
    </div>
</div>