<div class="col-md-5 col-lg-4 text-center text-md-start">
    <div class="card shadow-sm p-3 mb-4 bg-white rounded">
        <img src="{{detailBook.cover}}" class="img-fluid rounded mx-auto d-block" alt="{{detailBook.title}}">
    </div>

    <div class="card shadow-sm mb-4 bg-white rounded overflow-hidden">
        <div class="card-body p-3 border-bottom">
            <h5 class="card-title fs-6 text-muted text-uppercase mb-0">
                <i class="fa-solid fa-location-dot text-primary me-2"></i> Posizione e Raggio
            </h5>
        </div>
        <div id="mapBookDetail" style="height: 300px;width: 100%;z-index: 1;"></div>
        <div class="card-footer bg-white border-top-0 p-3">
            <div class="row text-center">
                <div class="col-6 border-end">
                    <small class="text-muted d-block text-uppercase">Latitudine</small>
                    <span  class="fw-bold text-dark text-break">{{detailBook.lat}}</span>
                </div>
                <div class="col-6">
                    <small class="text-muted d-block text-uppercase">Longitudine</small>
                    <span class="fw-bold text-dark text-break">{{detailBook.lon}}</span>
                </div>
            </div>
        </div>
    </div>
</div>