<!-- Form utilizzato per la registrazione utente -->
<form id="registration" class="registration-needs-validation" novalidate>
    <div class="row g-4">
        <div class="col-12 col-md-6">
            <label for="first_name" class="form-label fw-semibold text-secondary">Nome <span class="text-danger" aria-hidden="true">*</span></label>
            <input type="text" id="first_name" value="" name="first_name" class="form-control form-control-lg border-secondary-subtle" placeholder="Inserisci il tuo nome" required>
            <div class="invalid-feedback">Inserisci il tuo nome".</div>
        </div>

        <div class="col-12 col-md-6">
            <label for="last_name" class="form-label fw-semibold text-secondary">Cognome <span class="text-danger" aria-hidden="true">*</span></label>
            <input type="text" id="last_name" value="" name="last_name" class="form-control form-control-lg border-secondary-subtle" placeholder="Inserisci il tuo cognome" required>
            <div class="invalid-feedback">Inserisci il tuo cognome.</div>
        </div>    

        <div class="col-12 col-md-12">
            <label for="description" class="form-label fw-semibold text-secondary">Parlaci un pò di te <span class="text-danger" aria-hidden="true">*</span></label>
            <textarea id="description" name="description" class="form-control form-control-lg border-secondary-subtle" placeholder="Inserisci una breve descrizione di te, massimo 500 caratteri.." maxlength="500" rows="4" required ></textarea>
            <div class="invalid-feedback">Inserisci una breve descrizione di te.</div>
        </div>
    
        <div class="col-12 col-md-12">
            <label for="email" class="form-label fw-semibold text-secondary">Indirizzo Email <span class="text-danger" aria-hidden="true">*</span></label>
            <input type="email" id="email" value="" name="email" class="form-control form-control-lg border-secondary-subtle" placeholder="nome@esempio.com" pattern="[\w-\.]+@([\w-]+\.)+[\w-]{2,4}" required>
            <div class="invalid-feedback">Inserisci un indirizzo email valido.</div>
        </div>

        <div class="col-12 col-md-6">
            <label for="password" class="form-label fw-semibold text-secondary">Password <span class="text-danger" aria-hidden="true">*</span></label>
            <div class="input-group mb-3">
            <input type="password" id="password" value="" name="password" minlength="8" class="form-control form-control-lg border-secondary-subtle" placeholder="Minimo 8 caratteri" pattern="(?=.*\d)(?=.*[a-z])(?=.*[A-Z]).{8,}" aria-describedby="button_view_password" required>
            <button class="btn btn-outline-secondary" type="button" id="button_view_password" onmouseover="viewPassword(this)"><i class="fa-solid fa-eye"></i></button>
            <div class="invalid-feedback">Password non valida</div>
            </div>
            
        </div>

        <div class="col-12 col-md-6">
            <label for="password_confirm" class="form-label fw-semibold text-secondary">Conferma Password <span class="text-danger" aria-hidden="true">*</span></label>
            <div class="input-group mb-3">
                <input type="password" id="password_confirm" value="" onChange="checkPasswordMatch();"  name="password_confirm" class="form-control form-control-lg border-secondary-subtle" placeholder="Ripeti la password" pattern="(?=.*\d)(?=.*[a-z])(?=.*[A-Z]).{8,}" aria-describedby="button_view_password" required>
                <button class="btn btn-outline-secondary" type="button" id="button_view_password" onmouseover="viewPassword(this)"><i class="fa-solid fa-eye"></i></button>
                <div class="invalid-feedback">Conferma password non valida</div>
            </div>                            
        </div> 

        <div class="col-12 col-md-12">
                <label for="address" class="form-label fw-semibold text-secondary">Indirizzo <span class="text-danger" aria-hidden="true">*</span></label>
                <div class="input-group">
                    <input type="text" id="address" value="" name="address" required class="form-control form-control-lg border-secondary-subtle" placeholder="Es. Via Toledo, Napoli">
                    <div class="invalid-feedback">Specifica un indirizzo per la geolocalizzazione sulla mappa.</div>
                </div>
            </div>

        <input type="hidden" id="latitude"  value="" name="latitude">
        <input type="hidden" id="longitude" value="" name="longitude">

        <div class="row g-3">
            <label for="captcha" class="form-label fw-semibold text-secondary">Dimostraci che non sei un Bot <span class="text-danger" aria-hidden="true">*</span></label>
            <div class="col-sm-7">
                <input type="text" id="captcha" name="captcha" class="form-control form-control-lg border-secondary-subtle" placeholder="...digita qui i caratteri che vedi nella figura" required>
                <div class="invalid-feedback">Digita i caratteri nella figura.</div>
            </div>
            <div class="col-sm">
                <img id="captchaImg" src="/api/captcha">
            </div>
            <div class="col-sm">
                <button type="button" id="refrescCaptchaImg" class="btn btn-outline-primary w-100 fw-bold py-2 shadow-sm mt-1">
                    Aggiorna <i class="fa-solid fa-rotate"></i>
                </button>
            </div>
        </div>

        <div class="mb-4 form-check">
            <input type="checkbox" class="form-check-input" name="agree_terms" id="agree_terms" required>
            <label class="form-check-label text-muted small" for="agree_terms">Accetto i termini di servizio, <a href="/terms-and-conditions">leggi termini di servizio</a></label>
            <div class="invalid-feedback">È necessario accettare i termini per continuare.</div>
        </div>

        <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold py-3 shadow-sm">
            Crea il mio profilo <i class="fa-solid fa-circle-chevron-right"></i>
        </button>    
    </div>
</form>
