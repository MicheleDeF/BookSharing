<form id="recover_password">
    <div class="row g-4">
        <div class="col-12">
            <label for="email" class="form-label fw-semibold text-secondary">Email
                <span class="text-danger" aria-hidden="true">*</span></label>
            <input type="text" id="email" name="email" class="form-control form-control-lg border-secondary-subtle" placeholder="Inserisci la tua email, es. nome@dominio.it" required>
            <div class="invalid-feedback">Inserisci la tua email</div>
        </div>    

        <div class="col-12 pt-3">
            <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold py-3 shadow-sm">
                Invia
            </button>
        </div>

    </div>
</form>