{{#section 'title'}}
ScambioLibro - {{detailBook.title}}
{{/section}}
{{#section 'leaflet'}}
<link rel="stylesheet" href="/leaflet.css" />
<script src="/leaflet.js"></script>
{{/section}}
{{#section 'css'}}
<link rel="stylesheet" href="/swiper/swiper-bundle.min.css" />
{{/section}}
{{#section 'schema'}}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Book",
  "name": "{{detailBook.title}},
  "url": "{{currentUrl}}",
  "datePublished": "{{detailBook.publish_year}}",
  "author": {
    "@type": "Person",
    "name": "{{detailBook.author}}"
  },
  "genre": "{{detailBook.category}}",
  "image": "{{detailBook.cover}}",
  "offers": {
    "@type": "Offer",
    "availability": "https://schema.org",
    "offeredBy": {
      "@type": "Person",
      "givenName": "{{detailBook.user.firstName}}",
      "familyName": "{{detailBook.user.lastName}}",
      "image": "{{detailBook.user.avatar}}",
      "homeLocation": {
        "@type": "Place",
        "name": "{{detailBook.address}}",
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": "{{detailBook.lat}}",
          "longitude": "{{detailBook.lon}}"
        }
      }
    }
  }
}
</script>
{{/section}}
{{#section 'script'}}
<script>   
    /** Visualizza sulla mappa il punto di scambio del libro. */  
    const lat = {{detailBook.lat}};
    const lon = {{detailBook.lon}};
    const radius = {{detailBook.radius}};
    const map = L.map('mapBookDetail').setView([lat, lon], 14);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '&copy; <a href="https://openstreetmap.org">OpenStreetMap</a> contributors'
    }).addTo(map);

    const marker = L.marker([lat, lon]).addTo(map);
    marker.bindPopup("<b>Punto di Scambio</b><br>{{detailBook.address}}").openPopup();

    const circle = L.circle([lat, lon], {
        color: '#0d6efd',       
        fillColor: '#0d6efd',   
        fillOpacity: 0.15,      
        radius: radius    
    }).addTo(map);

   setTimeout(() => {
    map.invalidateSize();
    map.fitBounds(circle.getBounds(), { padding: [20, 20] });
        }, 200);

    function notLogged(){
        Swal.fire({
            icon: "info",
            title: "Oops...",
            text: "Per contattare il proprietario del libro devi effettuare il login!",
            confirmButtonText: "Chiudi",
            footer: `<a href="/login" class="btn text-primary">Vai alla pagina del login <i class="fa-solid fa-arrow-right-long"></i></a>`
            });
    }
</script>
<script src="/swiper/swiper-bundle.min.js"></script>
<script src="/js/book-detail/book-detail.js"></script>
{{/section}}
<br/>
<div class="container detail-book">
    <div class="row g-4">              
        <!-- COLONNA SINISTRA -->
        {{> pages/book-detail/left-column detailBook=detailBook }}
        <!-- COLONNA DESTRA -->
        {{> pages/book-detail/right-column detailBook=detailBook lenghtUserBooks=lenghtUserBooks userBooks=userBooks }}
    </div>
</div>