{{#section 'title'}}
Passalibro - {{detailBook.title}}
{{/section}}
{{#section 'leaflet'}}
<link rel="stylesheet" href="/leaflet.css" />
<script src="/leaflet.js"></script>
{{/section}}
{{#section 'script'}}
<script>     
    const lat = {{detailBook.lat}};
    const lon = {{detailBook.lon}};
    const radius = {{detailBook.radius}};
    const map = L.map('mapBookDetail').setView([lat, lon], 14);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '&copy; <a href="https://openstreetmap.org">OpenStreetMap</a> contributors'
    }).addTo(map);

    const marker = L.marker([lat, lon]).addTo(map);
    marker.bindPopup("<b>Punto di Scambio</b><br>{{detailBook.address}}").openPopup();

    const circle = L.circle([lat, lon], {
        color: '#0d6efd',       
        fillColor: '#0d6efd',   
        fillOpacity: 0.15,      
        radius: radius    
    }).addTo(map);

   setTimeout(() => {
    map.invalidateSize();
    map.fitBounds(circle.getBounds(), { padding: [20, 20] });
        }, 200);

    function notLogged(){
        Swal.fire({
            icon: "info",
            title: "Oops...",
            text: "Per contattare il proprietario del libro devi effettuare il login!",
            confirmButtonText: "Chiudi",
            footer: `<a href="/login" class="btn text-primary">Vai alla pagina del login <i class="fa-solid fa-arrow-right-long"></i></a>`
            });
    }
</script>
<script src="/js/book-detail/book-detail.js"></script>
{{/section}}
<br/>
<div class="container detail-book">
    <div class="row g-4">
              
        <!-- COLONNA SINISTRA -->
        <div class="col-md-5 col-lg-4 text-center text-md-start">
            <div class="card shadow-sm p-3 mb-4 bg-white rounded">
                <img src="{{detailBook.cover}}" class="img-fluid rounded mx-auto d-block" alt="{{detailBook.title}}">
            </div>

            <div class="card shadow-sm mb-4 bg-white rounded overflow-hidden">
                <div class="card-body p-3 border-bottom">
                    <h5 class="card-title fs-6 text-muted text-uppercase mb-0">
                        <i class="fa-solid fa-location-dot text-primary me-2"></i> Posizione e Raggio
                    </h5>
                </div>
                <div id="mapBookDetail" style="height: 300px;width: 100%;z-index: 1;"></div>
                <div class="card-footer bg-white border-top-0 p-3">
                    <div class="row text-center">
                        <div class="col-6 border-end">
                            <small class="text-muted d-block text-uppercase">Latitudine</small>
                            <span  class="fw-bold text-dark text-break">{{detailBook.lat}}</span>
                        </div>
                        <div class="col-6">
                            <small class="text-muted d-block text-uppercase">Longitudine</small>
                            <span class="fw-bold text-dark text-break">{{detailBook.lon}}</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- COLONNA DESTRA -->
        <div class="col-md-7 col-lg-8">
            
           <div class="card shadow-sm p-4 mb-4 bg-white rounded">
                <div class="d-flex flex-wrap gap-2 mb-3">
                    <span class="badge bg-secondary px-3 py-2 rounded-pill fs-6">{{detailBook.category}}</span>
                </div>

                <h1 class="display-5 fw-bold text-dark mb-1">{{detailBook.title}}</h1>
                <p class="fs-4 text-muted mb-3">di <span class="text-dark fw-semibold">{{detailBook.author}}</span>, anno di pubblicazione <span class="text-dark fw-semibold">{{detailBook.publish_year}}</span></p>
                
                <hr class="my-4">

                <div class="row g-3 mb-4">
                    <div class="col-sm-5">
                        <div class="d-flex align-items-center">
                            <i class="fa-solid fa-calendar text-primary fs-4 me-3"></i>
                            <div>
                                <small class="text-muted d-block">Data di Inserimento</small>
                                <span class="fw-medium">{{customizeData detailBook.createdAt}}</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-7">
                        <div class="d-flex align-items-center">
                            <i class="fa-solid fa-door-open text-primary fs-4 me-3"></i>
                            <div>
                                <small class="text-muted d-block">Indirizzo di Scambio</small>
                                <span class="fw-medium">{{detailBook.address}}</span>
                            </div>
                        </div>
                    </div>
                </div>


                <div class="alert alert-primary d-flex align-items-center mb-4" role="alert">
                    <i class="fa-solid fa-satellite-dish fs-4 me-3"></i>
                    <div>
                        Questo libro viene condiviso entro un raggio di <strong>{{detailBook.radius}} metri</strong> dal proprietario del libro.
                    </div>
                </div>

                <h5 class="fw-bold mb-3">Descrizione libro</h5>
                <p class="text-secondary leading-relaxed">
                   {{detailBook.description}}
                </p>
            </div>


            <div class="card shadow-sm p-4 bg-white rounded">
                <h5 class="card-title border-bottom pb-3 mb-3">Info proprietario</h5>
                <div class="d-flex align-items-start align-items-sm-center flex-column flex-sm-row">
                    <img src="{{detailBook.user.avatar}}" class="rounded-circle mb-3 mb-sm-0 me-sm-4 shadow-sm">                    
                    <div>
                        <h4 class="h5 fw-bold mb-1">{{detailBook.user.firstName}} {{detailBook.user.lastName}}</h4>
                        <p class="text-secondary mb-0">
                             {{detailBook.user.description}} 
                        </p>
                    </div>
                </div>
                
                <p class="border">
                    {{#if userLogged.logged}} 

                        {{#if (eq userLogged.id detailBook.user.id)}} 
                           <!--
                            Nota:
                            l'utente loggato è il proprietario del libro,
                            il form "Contatta il proprietario" non è visibile.                            
                            -->
                        {{else}} 
                        <form id="sendMesssageOnDetailBook">
                            <input type="hidden" name="recipient" value="{{detailBook.user.id}}">
                            <input type="hidden" name="bookId" value="{{detailBook.id}}">
                            <div class="mb-3">
                                <textarea name="textRecipient" class="form-control border border-primary" placeholder="....contatta {{detailBook.user.firstName}} {{detailBook.user.lastName}}" rows="4" required></textarea>
                            </div>
                            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                <button type="submit" class="btn btn-primary me-md-2">
                                    <i class="fa-solid fa-message me-2"></i> Invia Messaggio
                                </button>
                            </div>
                        </form>
                        {{/if}} 

                    {{else}}  
                    <form onsubmit="notLogged(); return false;">
                        <div class="mb-3">
                            <textarea name="textRecipient" class="form-control border border-primary" placeholder="....contatta {{detailBook.user.firstName}} {{detailBook.user.lastName}}" rows="4"></textarea>
                        </div>
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <button type="submit" class="btn btn-primary me-md-2">
                                <i class="fa-solid fa-message me-2"></i> Invia Messaggio
                            </button>
                        </div>
                    </form>
                    {{/if}}                       
                </p>
            </div>

        </div>
    </div>
</div>