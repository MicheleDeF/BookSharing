{{#section 'title'}}
ScambioLibro - Modifica Libro: {{book.title}}
{{/section}}

<main class="container-xl py-5 flex-grow-1">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">                
            <div class="mb-4">
                <figure>
                    <blockquote class="blockquote">
                        <h1 class="h2 fw-extrabold text-dark">Modifica Libro:</h1>
                    </blockquote>
                    <figcaption class="blockquote-footer">
                         {{book.title}}
                    </figcaption>
                </figure>                
                <p class="text-secondary"><span class="text-danger" aria-hidden="true">*</span> campo obbligatorio</p>
            </div>                
            <div class="card p-4 p-md-5 shadow-sm border-secondary-subtle rounded-3 bg-white">                    
                    {{> pages/edit-book/form detailBook=book }}
            </div>
        </div>
    </div>
</main>

{{> pages/insert-book/cropperModal }}
{{#section 'css'}}
<link  href="/cropper.css" rel="stylesheet">
{{/section}}

{{#section 'script'}}
<script src="/cropper.js"></script>
<script src="/jquery-cropper.js"></script>
<script src="/js/edit-book/edit-book.js"></script> 
{{/section}}