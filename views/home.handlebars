{{#section 'title'}}
ScambioLibro - Home
{{/section}}
{{#section 'css'}}
<link rel="stylesheet" href="/swiper/swiper-bundle.min.css" />
{{/section}}
{{#section 'script'}}
<script src="/swiper/swiper-bundle.min.js"></script>
<script>const latestBooks = {{{ json latestBooks }}};</script>
<script src="/js/home/home.js"></script> 
{{/section}}
<section id="section-home" class="border-bottom py-5 py-lg-5">
    <div class="container-xl py-4">
        <div class="row align-items-center g-5">
            <div class="col-12 col-lg-7 p-4 shadow-lg border-light rounded-4 bg-light bg-opacity-75">
                <p class="lead mb-4">
                <h5><span class="badge text-bg-primary text-light ms-1">nel quartiere <i
                            class="fa-solid fa-person-walking"></i></span></h5>
                </p>
                <h1 class="display-6 fw-extrabold mb-3">
                    I libri che cerchi sono a pochi passi da te...
                </h1>
                <p class="lead mb-4">
                    Condividi il tuo patrimonio librario con la comunità locale, scopri i testi disponibili nelle tue vicinanze e
                    scambiali a costo zero e senza spedizioni...
                </p>
                <div class="d-flex flex-wrap gap-3">
                    <a href="#" onclick="return false;" id="view-map"
                        class="btn btn-primary text-light px-4 py-3 fw-bold border">
                        Esplora i libri vicini <i class="fa-solid fa-map-location-dot"></i>
                    </a>
                    <a href="/insert-book" class="btn btn-primary text-light px-4 py-3 fw-bold border">
                        Aggiungi un libro <i class="fa-solid fa-book"></i>
                    </a>
                </div>
            </div>
            <div class="col-12 col-lg-5">
                <div class="card p-4 shadow-lg border-light rounded-4 bg-light bg-opacity-75">
                    {{> pages/home/form }}
                </div>
            </div>
        </div>
    </div>
</section>
    <br/>
    <div class="container home">
        <div class="row">
            <div class="col">
                <h1 class="display-6">
                 Libri Recenti <small class="text-body-secondary">vicino a te <i class="fa-solid fa-street-view"></i></small>
                </h1>
            </div>
        </div>
        <div class="row">
            <div class="col">
                {{#if (eq latestBooks.length 0)}}
                   <h6>Nessun libro nelle vicinanze!</h6> 
                  {{else}}
                    <div class="swiper latest_books position-relative">
                        <div class="swiper-wrapper">
                            {{#each latestBooks}}
                            <div class="swiper-slide">
                                <div class="card shadow-sm">
                                    <img src="{{this.cover}}" class="card-img-top" alt="{{this.title}}">
                                    <div class="card-body d-flex flex-column">
                                        <h6 class="card-title">
                                            {{truncate this.title 20}}
                                        </h6>
                                        <p class="card-text flex-grow-1">
                                            {{truncate this.description 50}}
                                        </p>
                                        <a href="/book/{{this.id}}/{{this.slug}}" class="btn btn-primary mt-auto">
                                            Vai al dettaglio <i class="fa-solid fa-arrow-right-long"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                            {{/each}}
                        </div>
                     <div class="swiper-button-prev"></div>
                     <div class="swiper-button-next"></div>
                    </div>                   
                 {{/if}}
            </div>
        </div>        
    </div>
<hr/>       