{{#section 'title'}}
Book Sharing - Home
{{/section}}
<section class=" border-bottom py-5 py-lg-5" aria-labelledby="hero-heading">
        <div class="container-xl py-4">
            <div class="row align-items-center g-5">
                
                <div class="col-12 col-lg-7">
                    <p class="lead text-secondary mb-4">
                      <ul class="list-inline">
                        <li class="list-inline-item">
                            <span class="badge text-bg-primary">A piedi</span>
                        </li>
                        <li class="list-inline-item">
                            <span class="badge text-bg-primary">Nel quartiere</span>
                        </li>
                        <li class="list-inline-item">
                            <span class="badge text-bg-primary">In città</span>
                        </li>
                        </ul>
                     </p>
                    <h1 id="hero-heading" class="display-5 fw-extrabold tracking-tight text-contrast-high mb-3">
                        I libri che cerchi sono a pochi passi da te.
                    </h1>
                    <p class="lead text-secondary mb-4">
                        Condividi le tue letture con la comunità locale, scopri i testi disponibili nel tuo palazzo e scambia cultura a costo zero e senza spedizioni.
                    </p>
                    <div class="d-flex flex-wrap gap-3">
                        <a href="view-map" class="btn btn-primary btn-lg px-4 py-3 fw-bold shadow-sm">
                            Esplora i libri vicini
                        </a>
                        <a href="insert-book" class="btn btn-light btn-lg px-4 py-3 fw-bold border text-secondary">
                            Aggiungi un libro
                        </a>
                    </div>
                </div>
                <div class="col-12 col-lg-5">
                    <div class="card p-4 shadow-lg border-light rounded-4 bg-light">
                        <h2 class="h4 fw-bold text-dark mb-4">Trova un libro adesso</h2>
                         {{> pages/home/form }}
                    </div>
                </div>
            </div>
        </div>
    </section>
    <br/>
    <div class="container">
        <div class="row">
            <div class="col">
                <h1 class="display-6">Libri Recenti</h1>
            </div>
        </div>
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-4">
            {{#each latestBooks}}
            <div class="col">
                <div class="card" style="width: 20rem;">
                    <img src="{{this.cover}}" class="card-img-top">
                    <div class="card-body">
                        <h6 class="card-title">{{this.title}}</h6>
                        <p><em>Autore: {{this.author}}</em></p>
                        <p class="card-text">{{truncate this.description 50}} </p>
                        <a href="/book/{{this.id}}/{{this.slug}}" class="btn btn-primary">
                            Vai al dettaglio <i class="fa-solid fa-arrow-right-long"></i>
                        </a>
                    </div>
                </div>
            </div>
            {{else}}
             <div class="col">Nessun Libro Recente.</div>
            {{/each}}
        </div>
    </div>
    <hr/>

        