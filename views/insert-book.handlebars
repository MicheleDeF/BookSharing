<main class="container-xl py-5 flex-grow-1">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">                
            <div class="mb-4">
                <figure>
                    <blockquote class="blockquote">
                        <h1 class="h2 fw-extrabold text-dark">Inserisci e Condividi con altri il tuo libro</h1>
                    </blockquote>
                    <figcaption class="blockquote-footer">
                         A piedi entro <cite title="500 metri">500 metri</cite>
                    </figcaption>
                </figure>                
                <p class="text-secondary"><span class="text-danger" aria-hidden="true">*</span> campo obbligatorio</p>
            </div>                
            <div class="card p-4 p-md-5 shadow-sm border-secondary-subtle rounded-3 bg-white">                    
                    {{> pages/insert-book/form }}
            </div>
        </div>
    </div>
</main>

